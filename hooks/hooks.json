{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/bin/warrant.py\" hook session" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/bin/warrant.py\" hook prompt" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/bin/warrant.py\" hook stop" } ] }
    ]
  }
}
